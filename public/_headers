# Cloudflare Pages : assets du nuage LiDAR (cf. scripts/split-pointcloud.mjs).
# Les .bin ont des noms VERSIONNÉS (c2-*.bin) → on peut les figer en immutable sans
# risque de stale : changer de layout ⇒ changer le préfixe ⇒ nouvelles URLs.
# Les .json (manifest/meta) restent en revalidation courte pour qu'un visiteur récupère
# vite un nouveau manifest (sinon il pointerait éternellement sur l'ancien jeu de chunks).
/pointcloud/*.bin
  Cache-Control: public, max-age=31536000, immutable
/pointcloud/*.json
  Cache-Control: public, max-age=60, must-revalidate

# Assets hashés par Vite (nom = empreinte du contenu) → figés en immutable sans
# risque de stale : un changement de contenu ⇒ nouveau hash ⇒ nouvelle URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts Aeonik (.woff2, stables ; bumper le nom de fichier si on remplace une fonte).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Modèles 3D (stables par version de déploiement).
/models/*
  Cache-Control: public, max-age=31536000, immutable

# Image OG, favicon/icônes, manifest : peuvent être ajustés → TTL modéré (1 jour).
/og-image.png
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/icons.svg
  Cache-Control: public, max-age=86400
/site.webmanifest
  Cache-Control: public, max-age=86400
