# Variables d'environnement de la Pages Function (dev local via `npm run dev:pages`).
# Copier en `.dev.vars` (gitignoré) et remplir. NE JAMAIS committer `.dev.vars`.

# Clé Bearer de l'app « gispreview » côté Daviking-Mailer.
# Générer : openssl rand -hex 32 — puis côté mailer : wrangler secret put MAILER_KEY_GISPREVIEW
MAILER_KEY=

# URL du worker mailer (optionnel ; défaut = prod).
MAILER_URL=https://daviking-mailer.blue-tree-8b17.workers.dev

# Origine autorisée supplémentaire (optionnel ; localhost et *.pages.dev déjà permis).
# ALLOWED_ORIGIN=https://votre-domaine.fr
